# Public URL layout (multi-tenant same-origin)
LANDING_PUBLIC_URL=https://restoos.optimizesolux.com
FRONTEND_PUBLIC_URL=https://restoos.optimizesolux.com
API_PUBLIC_URL=https://restoos.optimizesolux.com/api
APP_HOSTNAME=restoos.optimizesolux.com

# Images (set by CD)
API_IMAGE=ghcr.io/aquila04/restoos-backend:latest
FRONTEND_IMAGE=ghcr.io/aquila04/restoos-frontend:latest

# Postgres métier
DB_NAME=restoos
DB_ADMIN_USER=restoos_admin
DB_APP_USER=restoos_app
DB_PASSWORD=change-me
DB_APP_PASSWORD=change-me-app

# Auth
OIDC_ISSUER_URI=https://auth.optimizesolux.com/realms/restoos
OIDC_AUDIENCE=restoos-api
OIDC_CLIENT_ID=restoos-frontend
JWT_SECRET=change-me-long-secret
RESTOOS_HMAC_SESSION_ENABLED=false
KEYCLOAK_URL=https://auth.optimizesolux.com
KEYCLOAK_ADMIN_CLIENT_ID=restoos-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-kc

# Redis (common-infra) — reserved DB 9 / prefix restoos:
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=9
RESTOOS_REDIS_BROKER=true

# Notification hub
OPTIMIZE_NOTIFICATION_HUB_ENABLED=true
OPTIMIZE_NOTIFICATION_HUB_BASE_URL=https://notification-api.optimizesolux.com
OPTIMIZE_NOTIFICATION_HUB_OAUTH2_TOKEN_URI=https://auth.optimizesolux.com/realms/notification-hub/protocol/openid-connect/token
OPTIMIZE_NOTIFICATION_HUB_OAUTH2_CLIENT_ID=restoos
OPTIMIZE_NOTIFICATION_HUB_OAUTH2_CLIENT_SECRET=change-me-hub
OPTIMIZE_NOTIFICATION_HUB_FROM=noreply@optimizesolux.com

RESTOOS_ACTIVATION_BASE_URL=https://restoos.optimizesolux.com/activate
RESTOOS_MAIL_FROM=noreply@optimizesolux.com
