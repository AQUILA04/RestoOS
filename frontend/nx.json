{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": []
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "cache": true
    }
  },
  "projects": {
    "pos-app": "apps/pos-app",
    "kds-app": "apps/kds-app",
    "admin-portal": "apps/admin-portal",
    "restoos-shell": "."
  }
}
