{
  "name": "resto-os-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4200 --host 0.0.0.0 --proxy-config proxy.conf.json",
    "start:pos": "ng serve --port 4200 --host 0.0.0.0 --proxy-config proxy.conf.json",
    "start:kds": "ng serve --port 4201 --host 0.0.0.0 --proxy-config proxy.conf.json",
    "start:admin": "ng serve --port 4202 --host 0.0.0.0 --proxy-config proxy.conf.json",
    "build": "ng build",
    "build:pos": "ng build",
    "build:kds": "ng build",
    "build:admin": "ng build",
    "test": "ng test --watch=false --browsers=ChromeHeadless",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config=e2e/playwright.config.ts --ui",
    "test:e2e:headed": "playwright test --config=e2e/playwright.config.ts --headed",
    "serve:e2e": "ng serve --configuration=development --port 4200 --host 127.0.0.1 --proxy-config proxy.conf.json"
  },
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@stomp/stompjs": "^7.0.0",
    "idb": "^8.0.0",
    "rxjs": "~7.8.1",
    "sockjs-client": "^1.6.1",
    "tslib": "^2.6.3",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.0",
    "@angular/cli": "^18.2.0",
    "@angular/compiler-cli": "^18.2.0",
    "@playwright/test": "^1.40.0",
    "@types/jasmine": "~5.1.0",
    "@types/sockjs-client": "^1.5.4",
    "http-server": "^14.1.1",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.3.0",
    "serve": "^14.2.4",
    "typescript": "~5.5.4"
  }
}
